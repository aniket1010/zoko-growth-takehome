# Copy to .env for local dev. Never commit .env.
PORT=4000
# Personal Neon connection string (not the company one)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Zoko API key for the "Zoko Customer Sales" test store
ZOKO_API_KEY=
ZOKO_API_BASE=https://chat.zoko.io/v2
# Optional. If set, the webhook rejects requests that do not carry this token.
ZOKO_WEBHOOK_TOKEN=
# Guardrail: comma-separated E.164 digits we are allowed to send to (your own / test number only)
SEND_ALLOWLIST=
# Frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# PostHog (Task 2)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
